{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrystalTides Launcher - Papyrus",
  "version": "0.1.0",
  "identifier": "net.crystaltides.launcher.papyrus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrystalTides Launcher - Papyrus",
        "width": 1280,
        "height": 720,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": ["Spanish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/UltraXn/crystal-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGF1dG91cGRhdGUgcHVibGljIGtleQpSV1N5TWpCa3JvVktGSmJndmRhbWR2bXNzZXZzYm1zZXZzYm1zZXZzYm1zZWQK"
    }
  }
}
