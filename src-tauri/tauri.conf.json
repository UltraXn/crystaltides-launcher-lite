{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrystalTides Launcher Lite",
  "version": "0.1.1",
  "identifier": "net.crystaltides.launcher.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrystalTides Launcher Lite",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "focus": true,
        "decorations": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: blob:; media-src 'self' data: https: asset: blob:; font-src 'self' data:; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/UltraXn/crystaltides-launcher-lite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2MzIzRjRDQUJBMEM5MUQKUldRZHlhQ3JURDh5Qm16UEd5T09ucHg3bHpoa1JFVUs4WDk5NHVOVkFQM01Mck1qbGVKY09Sbm8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
