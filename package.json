{
  "$schema": "https://json.schemastore.org/package",
  "name": "@crystaltides/launcher-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:fast": "oxlint --no-ignore src",
    "doctor": "react-doctor",
    "doctor:score": "react-doctor --score",
    "doctor:staged": "react-doctor --staged --blocking warning",
    "doctor:changed": "react-doctor --verbose --scope changed",
    "lint:rust": "cargo clippy -p launcher-lite-tauri",
    "deny:rust": "cargo deny check",
    "machete:rust": "cargo machete",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "oxlint": "^0.15.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
